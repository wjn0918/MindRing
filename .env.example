# MindRing runtime configuration. Copy to .env and adjust for your environment.
APP_NAME=微光年轮 API
ENVIRONMENT=development

# Option 1: provide a full SQLAlchemy URL. This takes precedence over MYSQL_*.
# DATABASE_URL=mysql+pymysql://mindring:mindring@127.0.0.1:3306/mindring?charset=utf8mb4

# Option 2: configure MySQL piece by piece.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mindring
MYSQL_PASSWORD=mindring
MYSQL_DATABASE=mindring
MYSQL_CHARSET=utf8mb4

WECHAT_APP_ID=
WECHAT_APP_SECRET=
ENABLE_CONTENT_SAFETY=false
