page {
  min-height: 100%;
  color: #edf3ff;
  background: radial-gradient(circle at 20% 0%, rgba(246, 215, 139, 0.16), transparent 28%),
    linear-gradient(180deg, #101826 0%, #172033 48%, #0b111d 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  line-height: 1.6;
  word-wrap: break-word;
  word-break: break-word;
}

.container {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 100rpx;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  background: rgba(20, 31, 50, 0.78);
  box-shadow: 0 28rpx 90rpx rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(24rpx);
  overflow: hidden;
}

.glow-text {
  color: #f6d78b;
  text-shadow: 0 0 24rpx rgba(246, 215, 139, 0.5);
}

.primary-button {
  height: 92rpx;
  border: 0;
  border-radius: 999rpx;
  color: #1a2333;
  background: linear-gradient(135deg, #f8df9c, #f4b86b);
  font-weight: 700;
  line-height: 92rpx;
  box-shadow: 0 16rpx 44rpx rgba(246, 215, 139, 0.24);
  font-size: 30rpx;
}

.secondary-button {
  height: 80rpx;
  border: 1rpx solid rgba(246, 215, 139, 0.35);
  border-radius: 999rpx;
  color: #f6d78b;
  background: rgba(246, 215, 139, 0.08);
  line-height: 80rpx;
  font-size: 28rpx;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 22rpx;
  color: #edf3ff;
  background: rgba(255, 255, 255, 0.06);
  font-size: 28rpx;
}

.input {
  height: 92rpx;
  padding: 0 28rpx;
}

.textarea {
  min-height: 300rpx;
  padding: 28rpx;
  line-height: 1.7;
}

.muted {
  color: #8d9bb2;
}

.tag {
  display: inline-flex;
  margin: 8rpx 12rpx 0 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #dfe8f9;
  background: rgba(255, 255, 255, 0.08);
  font-size: 24rpx;
}
