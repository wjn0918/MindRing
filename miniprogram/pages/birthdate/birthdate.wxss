.container {
  padding: 40rpx 30rpx;
}

.card {
  background: rgba(246, 215, 139, 0.05);
  border: 1rpx solid rgba(246, 215, 139, 0.15);
  border-radius: 16rpx;
  padding: 50rpx 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  color: #f6d78b;
  margin-bottom: 20rpx;
}

.desc {
  color: #8d9bb2;
  font-size: 28rpx;
  margin-bottom: 50rpx;
  line-height: 1.7;
}

.picker-wrap {
  margin-bottom: 50rpx;
}

.date-picker {
  background: rgba(16, 24, 38, 0.8);
  border: 1rpx solid rgba(246, 215, 139, 0.3);
  border-radius: 12rpx;
  padding: 30rpx 24rpx;
  font-size: 30rpx;
  color: #eef4ff;
  text-align: center;
}
