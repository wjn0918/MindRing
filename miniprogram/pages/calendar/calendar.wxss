.summary {
  padding: 42rpx 36rpx;
  margin-bottom: 28rpx;
  text-align: center;
}

.summary-title {
  font-size: 86rpx;
  font-weight: 900;
}

.summary-copy {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.summary-sub {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.calendar {
  padding: 30rpx;
}

.calendar-title {
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.empty {
  padding: 58rpx 0;
  text-align: center;
}

.day-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.day-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.day-item:last-child {
  border-bottom: 0;
}

.glow-dot {
  width: 32rpx;
  height: 32rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  background: rgba(246, 215, 139, 0.38);
}

.level-2 {
  background: rgba(246, 215, 139, 0.68);
  box-shadow: 0 0 26rpx rgba(246, 215, 139, 0.4);
}

.level-3 {
  background: #f6d78b;
  box-shadow: 0 0 42rpx rgba(246, 215, 139, 0.76);
}

.day-date {
  flex: 1;
  font-size: 28rpx;
  min-width: 0;
}

.day-count {
  flex-shrink: 0;
  color: #aebbd0;
  font-size: 24rpx;
}
