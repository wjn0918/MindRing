.home .hero {
  padding: 42rpx 36rpx;
}

.user-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.user-info-section {
  flex: 1;
  min-width: 0;
}

.user-actions {
  flex-shrink: 0;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid rgba(246, 215, 139, 0.4);
  box-shadow: 0 0 24rpx rgba(246, 215, 139, 0.2);
}

.user-avatar .avatar-img {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
}

.user-avatar .avatar-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f6d78b, #f4b86b);
}

.eyebrow {
  margin-bottom: 18rpx;
  color: #f6d78b;
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
}

.subtitle {
  margin-top: 20rpx;
  color: #aebbd0;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 操作按钮区 */
.action-buttons {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 0;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.search-btn {
  background: rgba(255, 255, 255, 0.08);
  color: #edf3ff;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.create-btn {
  background: linear-gradient(135deg, #f8df9c, #f4b86b);
  color: #1a2333;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-icon {
  position: relative;
}

.search-icon::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 10rpx;
  height: 3rpx;
  background: currentColor;
  transform: rotate(45deg);
}

.plus-icon {
  position: relative;
}

.plus-icon::before,
.plus-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #1a2333;
}

.plus-icon::before {
  width: 4rpx;
  height: 20rpx;
}

.plus-icon::after {
  width: 20rpx;
  height: 4rpx;
}

.section-title {
  margin: 36rpx 4rpx 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.empty {
  padding: 48rpx 12rpx;
  text-align: center;
}

.concept-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.concept-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.concept-main {
  flex: 1;
  min-width: 0;
}

.concept-name {
  font-size: 34rpx;
  font-weight: 700;
}

.concept-description {
  margin-top: 12rpx;
  color: #aebbd0;
  font-size: 26rpx;
  line-height: 1.6;
  word-wrap: break-word;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.concept-badge {
  margin-left: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #9fb1cc;
  background: rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
}

.concept-badge.pinned {
  color: #1a2333;
  background: #f6d78b;
}

.login-button {
  max-width: 190rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid rgba(246, 215, 139, 0.3);
  border-radius: 999rpx;
  color: #f6d78b;
  background: rgba(246, 215, 139, 0.08);
  font-size: 24rpx;
  line-height: 64rpx;
}

.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(5, 10, 18, 0.72);
}

.privacy-card {
  padding: 36rpx;
}

.privacy-title {
  margin-bottom: 18rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.privacy-copy {
  margin-bottom: 28rpx;
  color: #aebbd0;
  font-size: 27rpx;
  line-height: 1.7;
}

.share-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.share-title {
  font-size: 28rpx;
  font-weight: 700;
}

.share-copy {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0;
  background: rgba(5, 10, 18, 0.72);
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  border-radius: 32rpx 32rpx 0 0;
  background: rgba(20, 31, 50, 0.98);
  backdrop-filter: blur(24rpx);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #aebbd0;
}

.modal-body {
  padding: 28rpx 36rpx 48rpx;
}

/* 搜索弹窗样式 */
.search-modal-row {
  display: flex;
  gap: 16rpx;
}

.search-modal-input {
  flex: 1;
}

.search-modal-button {
  width: 140rpx;
  height: 88rpx;
  border-radius: 24rpx;
  color: #1a2333;
  background: #f6d78b;
  font-weight: 700;
  line-height: 88rpx;
  font-size: 28rpx;
}

/* 创建弹窗样式 */
.create {
  padding: 0;
}

.create .input,
.create .textarea {
  margin-bottom: 20rpx;
}

.mini-textarea {
  min-height: 148rpx;
}
