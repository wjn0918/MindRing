.prompt {
  padding: 36rpx;
  margin-bottom: 28rpx;
}

.prompt-title {
  font-size: 38rpx;
  font-weight: 800;
  word-wrap: break-word;
  word-break: break-word;
}

.prompt-subtitle {
  margin-top: 16rpx;
  color: #aebbd0;
  font-size: 26rpx;
  line-height: 1.7;
  word-wrap: break-word;
  word-break: break-word;
}

.form {
  padding: 28rpx;
}

.form .input,
.form .textarea,
.date-row,
.share-row {
  margin-bottom: 22rpx;
}

.content {
  min-height: 420rpx;
  line-height: 1.65;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-pill {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  color: #f6d78b;
  background: rgba(246, 215, 139, 0.1);
}

.share-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.share-title {
  font-size: 28rpx;
  font-weight: 700;
}

.share-copy {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.45;
}
