<view class="container login-page">
  <view class="hero-section">
    <view class="logo-icon"></view>
    <view class="title">微光年轮</view>
    <view class="subtitle">记录概念、回看旧理解、看见自己如何慢慢改变</view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="login-card card">
    <view class="login-title">开始你的认知之旅</view>
    <view class="login-desc">登录后可以保存你的概念和理解记录，数据会安全存储</view>
    
    <button 
      class="primary-button login-btn" 
      loading="{{loading}}" 
      bindtap="loginWithWechat">
      <view class="wechat-icon"></view>
      微信一键登录
    </button>
    
    <button class="secondary-button guest-btn" bindtap="loginAnonymously">
      随便看看
    </button>
    
    <view class="tips muted">
      <view class="tip-item">· 记录你的每一次认知变化</view>
      <view class="tip-item">· 对比理解，看见成长</view>
      <view class="tip-item">· 共享概念，和他人一起思考</view>
    </view>
  </view>

  <view wx:else class="profile-card card">
    <view class="profile-header">
      <view class="avatar">
        <view wx:if="{{user.avatarUrl}}" class="avatar-img" style="background-image: url({{user.avatarUrl}})"></view>
        <view wx:else class="avatar-placeholder"></view>
      </view>
      <view class="user-info">
        <view class="user-name">{{user.nickname}}</view>
        <view class="user-id muted">ID: {{user.id}}</view>
      </view>
    </view>
    
    <view class="profile-actions">
      <button class="secondary-button" bindtap="logout">退出登录</button>
      <button class="primary-button" bindtap="loginAnonymously">去首页</button>
    </view>
  </view>
</view>
