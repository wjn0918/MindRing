<view class="container login-page">
  <view class="hero-section">
    <view class="logo-icon"></view>
    <view class="title">微光年轮</view>
    <view class="subtitle">记录概念、回看旧理解、看见自己如何慢慢改变</view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="login-card card">
    <view class="login-title">开始你的认知之旅</view>
    <view class="login-desc">登录后可以保存你的概念和理解记录，数据会安全存储</view>
    
    <button 
      class="primary-button login-btn" 
      loading="{{loading}}" 
      bindtap="loginWithWechat">
      <view class="wechat-icon"></view>
      微信一键登录
    </button>
    
    <button class="secondary-button guest-btn" bindtap="loginAnonymously">
      随便看看
    </button>
    
    <view class="tips muted">
      <view class="tip-item">· 记录你的每一次认知变化</view>
      <view class="tip-item">· 对比理解，看见成长</view>
      <view class="tip-item">· 共享概念，和他人一起思考</view>
    </view>
  </view>

  <view wx:else class="profile-card card">
    <view class="profile-header">
      <view class="avatar">
        <view wx:if="{{user.avatar_url}}" class="avatar-img" style="background-image: url({{user.avatar_url}})"></view>
        <view wx:else class="avatar-placeholder"></view>
      </view>
      <view class="user-info">
        <view class="user-name-row">
          <view class="user-name">{{user.nickname || '微光旅人'}}</view>
          <button class="edit-name-button" bindtap="openNicknameEditor">修改</button>
        </view>
        <view class="user-id muted">ID: {{user.id}}</view>
      </view>
    </view>
    
    <view class="birthdate-section">
      <view class="birthdate-label">出生年月</view>
      <view class="birthdate-value">
        {{user.birth_date || '未设置'}}
      </view>
      <view class="birthdate-action">
        <button class="secondary-button" bindtap="goToSetBirthdate">
          {{user.birth_date ? '修改' : '设置'}}
        </button>
      </view>
    </view>
    
    <view class="profile-actions">
      <button class="secondary-button" bindtap="logout">退出登录</button>
      <button class="primary-button" bindtap="loginAnonymously">去首页</button>
    </view>
  </view>

  <view wx:if="{{showNicknameEditor}}" class="modal-mask" bindtap="closeNicknameEditor">
    <view class="nickname-modal card" catchtap="stopPropagation">
      <view class="modal-title">修改昵称</view>
      <view class="modal-desc">设置一个想展示给自己的名字，最长 120 个字符。</view>
      <input
        class="nickname-input"
        value="{{nicknameDraft}}"
        maxlength="120"
        placeholder="请输入新的昵称"
        focus="{{showNicknameEditor}}"
        bindinput="onNicknameInput"
      />
      <view class="modal-actions">
        <button class="secondary-button" bindtap="closeNicknameEditor" disabled="{{savingNickname}}">取消</button>
        <button class="primary-button" bindtap="saveNickname" loading="{{savingNickname}}">保存</button>
      </view>
    </view>
  </view>
</view>
