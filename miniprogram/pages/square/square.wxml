<view class="container square-page">
  <view class="hero card">
    <view class="eyebrow">MindRing · 广场</view>
    <view class="title">探索所有概念</view>
    <view class="subtitle">发现你感兴趣的概念，留下你的年轮</view>
  </view>

  <view class="search-row">
    <input class="input search-input" placeholder="搜索概念" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
    <button class="search-button" bindtap="onSearch">搜索</button>
  </view>

  <view class="section-title">全部概念</view>
  <view wx:if="{{loading}}" class="empty muted">正在加载...</view>
  <view wx:elif="{{concepts.length === 0}}" class="empty muted">还没有概念，来创建第一个吧！</view>
  <view wx:else class="concept-list">
    <view wx:for="{{concepts}}" wx:key="id" class="concept-card card" data-id="{{item.id}}" bindtap="openConcept">
      <view class="concept-main">
        <view class="concept-name">{{item.name}}</view>
        <view wx:if="{{item.description}}" class="concept-description">{{item.description}}</view>
        <view wx:else class="concept-description muted">等待你的第一条年轮</view>
      </view>
    </view>
  </view>
</view>
